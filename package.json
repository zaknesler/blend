{
  "name": "blend-ui",
  "version": "0.0.0",
  "author": "Zak Nesler (https://nesler.dev)",
  "type": "module",
  "scripts": {
    "dev": "vite ui",
    "build": "vite build ui",
    "serve": "vite preview ui",
    "ci": "oxlint ./ui/src && oxfmt --check ./ui/src ./ui/types",
    "lint": "oxlint ./ui/src",
    "lint:fix": "oxlint --fix ./ui/src",
    "format": "oxfmt ./ui/src ./ui/types",
    "test": "vitest run --root ui",
    "test:cov": "vitest run --root ui --coverage",
    "typecheck": "tsc --build --noEmit",
    "watch": "mprocs \"pnpm run dev\" \"cargo watch -x \\\"run -- start\\\"\"",
    "watch:trace": "mprocs \"pnpm run dev\" \"cargo watch -x \\\"run -- -ltrace start\\\"\"",
    "typeshare:generate": "typeshare ./ --lang typescript --output-file ./ui/types/bindings.ts && oxfmt ./ui/types/bindings.ts"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.14",
    "@kobalte/tailwindcss": "^0.9.0",
    "@solid-primitives/active-element": "^2.1.6",
    "@solid-primitives/bounds": "^0.1.7",
    "@solid-primitives/keyboard": "^1.3.7",
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/scheduled": "^1.5.3",
    "@solid-primitives/scroll": "^2.1.6",
    "@solidjs/router": "^1.0.1",
    "@tanstack/solid-query": "^5.107.1",
    "@tanstack/solid-query-devtools": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "partysocket": "^1.3.0",
    "solid-icons": "^1.2.0",
    "solid-js": "^1.9.18",
    "solid-transition-group": "^0.3.0",
    "wretch": "^3.0.9"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "autoprefixer": "^10.6.2",
    "jsdom": "^31.0.0",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "postcss": "^8.5.32",
    "solid-devtools": "^0.34.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.1.0-beta",
    "vite": "^8.3.6",
    "vite-plugin-solid": "^2.11.15",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
