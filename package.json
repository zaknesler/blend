{
  "name": "blend-ui",
  "type": "module",
  "version": "0.0.0",
  "author": "Zak Nesler (https://nesler.dev)",
  "packageManager": "bun@1.3.5",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite ui",
    "build": "vite build ui",
    "serve": "vite preview ui",
    "ci": "biome ci ./ui/src",
    "lint": "biome check ./ui/src",
    "lint:fix": "biome check --write ./ui/src",
    "test": "vitest run --root ui",
    "test:watch": "vitest watch --root ui",
    "test:cov": "vitest run --root ui --coverage",
    "watch": "mprocs \"bun run dev\" \"cargo watch -x \\\"run -- start\\\"\"",
    "watch:trace": "mprocs \"bun run dev\" \"cargo watch -x \\\"run -- -ltrace start\\\"\"",
    "typeshare:generate": "typeshare ./ --lang typescript --output-file ./ui/types/bindings.ts && biome check --write ./ui/types/bindings.ts"
  },
  "dependencies": {
    "@kobalte/core": "^0.13.11",
    "@kobalte/tailwindcss": "^0.9.0",
    "@solid-primitives/active-element": "^2.1.3",
    "@solid-primitives/bounds": "^0.1.3",
    "@solid-primitives/keyboard": "^1.3.3",
    "@solid-primitives/resize-observer": "^2.1.3",
    "@solid-primitives/scheduled": "^1.5.2",
    "@solid-primitives/scroll": "^2.1.3",
    "@solidjs/router": "^0.15.4",
    "@tanstack/solid-query": "^5.90.22",
    "@tanstack/solid-query-devtools": "^5.91.2",
    "class-variance-authority": "^0.7.1",
    "partysocket": "^1.1.10",
    "solid-icons": "^1.1.0",
    "solid-js": "^1.9.10",
    "solid-transition-group": "^0.3.0",
    "wretch": "^3.0.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.11",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@total-typescript/ts-reset": "^0.6.1",
    "@vitest/coverage-v8": "^4.0.17",
    "autoprefixer": "^10.4.23",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.6",
    "solid-devtools": "^0.34.4",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vite-tsconfig-paths": "^6.0.4",
    "vitest": "^4.0.17"
  }
}
