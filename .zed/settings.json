{
  "format_on_save": "on",
  "formatter": {
    "external": {
      "command": "./node_modules/.bin/oxfmt",
      "arguments": ["--stdin-filepath", "{buffer_path}"],
    },
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["oxlint", "typescript-ls", "!vtsls", "!typescript-language-server"],
    },
    "TypeScript": {
      "language_servers": ["oxlint", "typescript-ls", "!vtsls", "!typescript-language-server"],
    },
    "TSX": {
      "language_servers": [
        "oxlint",
        "typescript-ls",
        "!vtsls",
        "!typescript-language-server",
        "tailwindcss-language-server",
        "emmet-language-server",
      ],
    },
    "HTML": {
      "language_servers": [
        "vscode-html-language-server",
        "tailwindcss-language-server",
        "emmet-language-server",
      ],
    },
    "JSON": {
      "language_servers": ["json-language-server", "npm-package-json-checker-lsp"],
    },
    "JSONC": {
      "language_servers": ["json-language-server"],
    },
    "CSS": {
      "language_servers": ["vscode-css-language-server"],
    },
  },
}
