{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": true,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "avoid",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": {
    "newlinesBetween": false
  },
  "sortTailwindcss": {
    "stylesheet": "./ui/src/styles/app.css"
  },
  "ignorePatterns": ["ui/dist", "ui/public", "pnpm-lock.yaml", "target"],
  "overrides": [
    {
      "files": ["*.css"],
      "options": { "singleQuote": false }
    }
  ]
}
